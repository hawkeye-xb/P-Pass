    <string name="notif_battery_reenabled_body">The system is limiting P-Pass in the background again, so background backup has stopped. Tap to allow it again.</string>
    <!-- NET-12: transfer foreground service ： keeps the process out of the
         cached-process range while a Flow round is actively sending, so
         the system cannot reclaim it mid-transfer (real device: it did,
         twice, on 2026-09-14). Silent/low-importance ： it's status, not
         an alert. -->
    <string name="notif_channel_transfer">Backing up</string>
    <string name="notif_transfer_title">Backing up photos</string>
    <!-- MOB-101: the system stopped letting the backup run while the app is
         off screen (it allows a limited amount of that each day). Plain
         words only: no error code, no class name, no jargon. The fact is
         learned only after the system refuses ： the wording says what
         happened, not what is about to happen. -->
    <string name="state_background_budget_paused">Background backup time is used up. Keep P-Pass on screen to continue, or it resumes on its own once the time is restored.</string>
    <string name="state_background_protection_unknown">The system didn\'t allow background backup. Keep P-Pass open on screen to continue.</string>
