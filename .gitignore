# P-Pass .gitignore

# Rust
target/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# Build artifacts
*.dmg
*.msi
*.apk
*.aab
*.so
# …but Android jniLibs MUST ship in the repo: the global *.so silently
# swallowed libiroh_ffi.so — every clone (CI, other machines) built APKs
# with no native lib, crashing on-device (UnsatisfiedLinkError, twice).
!apps/android/app/src/main/jniLibs/**/*.so

# tools/fetch-ffmpeg.sh 下载的 ffmpeg（默认落在 tools/ffmpeg/）。
# SEC-08 (#363)：它有 130 MB 量级，之前不在本文件里，跑一次脚本就在工作区
# 留一个未跟踪的大二进制，离被 git add -A 带进仓库只差一步。
# 上面 Build artifacts 那组后缀兑不上它（没有 *.exe，Linux/macOS 侧更是无后缀）。
tools/ffmpeg/

# Wrangler
.wrangler/
node_modules/

# Dev data
dev.db
dev.db-journal
dev.db-wal

# iroh-probe 持久化私钥（秘密，不进仓库）
iroh-probe.key
apps/android/.gradle/
apps/android/local.properties
apps/android/**/build/
.gstack/
/local-state.md
/docs/local-review.md

# agent worktrees（本地临时，不入库）
.claude/worktrees/
.worktrees/
