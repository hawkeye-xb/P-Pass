#!/usr/bin/env bash
# 研发本地看改动：编开发版并覆盖装到测试设备（ADR：每台测试设备一个安装槽，先取设备锁再覆盖）。
#
#   tools/e3/dev mac               编开发版签名包 → 取 mac 锁 → 留快照 → 覆盖 ~/Applications/P-Pass.app → 等服务就绪
#   tools/e3/dev mac --build-only  只编（产物 ~/.cache/ppass-e3/mac-cand/P-Pass.app；just verify 用它当候选）
# 看完装回：tools/e3/restore mac --snapshot（装回覆盖前那一份）或 tools/e3/restore mac <tag>。
# Android / Windows / iOS：TODO。
set -uo pipefail
E3_ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
source "$E3_ROOT/lib/common.sh"
source "$E3_LIB/mac.sh"
source "$E3_LIB/mac-install.sh"
dev="${1:-}"
case "$dev" in
  mac)
    if [ "${E3_LOCKED_MAC:-}" != 1 ]; then
      log "编开发版签名包"
      mac_build_dev || die "开发版编译失败"
      [ "${2:-}" = --build-only ] && { echo "$(mac_cand_app)"; exit 0; }
      exec "$E3_ROOT/lock" mac "$0" mac --install-only
    fi
    [ "${2:-}" = --install-only ] || mac_build_dev || die "开发版编译失败"
    # 只在装的是正式签名包（带 Apple 时间戳）时留快照：连着 dev 两次，--snapshot 仍装回最初那一份
    if codesign -dvv "$MAC_APP" 2>&1 | grep -q '^Timestamp=' || [ ! -d "$E3_STATE/mac-snapshot/P-Pass.app" ]; then
      mac_snapshot >/dev/null || die "留快照失败"
    fi
    mac_install_app "$(mac_cand_app)" || die "覆盖安装后服务没就绪（装回：tools/e3/restore mac --snapshot）"
    echo "已装开发版 $(mac_app_version)（覆盖前是 $(cat "$E3_STATE/mac-snapshot/version.txt")；装回：just restore mac --snapshot）"
    ;;
  *) sed -n 2,8p "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
