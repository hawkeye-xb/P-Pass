#!/usr/bin/env bash
# 本地提交拦截：核心禁区黑名单 + 独立 worktree 保护。由转发器（tools/hooks/dispatch.sh）先执行本机
# 原有私有钩子（~/.git-allowed-identities、公司词拦截、gitleaks），再从 HEAD 取出本脚本运行，
# 说明见 docs/runbook/local-hooks.md。
#
#   batch/*                         不拦（owner 的批分支）
#   <type>/<issue号>-<slug>         查该 issue（多卡分支查 branch.<分支>.ppasscards 全部关联卡）：
#     - 普通业务与测试文件自由修改（不再拦截单卡普通文件范围白名单，#1953）
#     - 暂存改动命中基线核心路径（优先取 origin/main:.github/core-paths.txt，离线回退 HEAD 规则；
#       带暂存区 diff：只改版本号行的不算核心，#1451）且没有一张卡带 `core` 标签 → 拒绝
#     - 卡分支在主仓工作区（不是 linked worktree）里 → 拒绝
#     - 落后 origin/main 超过 PPASS_HOOK_MAX_BEHIND（默认 20）个提交，或 main 上已有新提交改过本次暂存
#       的同一个文件 → 拒绝（现取 origin/main；取不到只告警）
#     - 合并 origin/main 解冲突的提交：与 MERGE_HEAD 内容相同的文件不算本卡改动
#   其它分支名、detached HEAD        拒绝
# 推送时另有 tools/hooks/pre-push：卡分支与远端 main 冲突时拒绝。
# 查不到 issue（没装 gh、没登录、离线）一律拒绝。
# 紧急逃生：PPASS_HOOK_BYPASS=1 PPASS_HOOK_BYPASS_REASON=<原因>，commit-msg 会在提交说明末尾记一行
# `Hook-Bypass: <原因>`。原因为空则拒绝。

set -uo pipefail

ROOT="${PPASS_HOOK_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
PATHS="${ROOT}/tools/ci-paths.sh"
RULES="${ROOT}/.github/core-paths.txt"

deny() { # deny <一句话原因> [补充行]...
  printf '\n✗ 提交被拦下：%s\n' "$1" >&2
  shift
  local l
  for l in "$@"; do printf '    %s\n' "$l" >&2; done
  printf '\n  规则见 AGENTS.md「交付流程」与 docs/runbook/local-hooks.md。\n\n' >&2
  exit 1
}

trim() { printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'; }

if [ "${PPASS_HOOK_BYPASS:-}" = "1" ]; then
  [ -n "$(trim "${PPASS_HOOK_BYPASS_REASON:-}")" ] ||
    deny "PPASS_HOOK_BYPASS=1 必须同时给出原因" \
      "用法：PPASS_HOOK_BYPASS=1 PPASS_HOOK_BYPASS_REASON='<为什么必须绕过>' git commit -s ..." \
      "原因会写进提交说明的 Hook-Bypass: 尾行，供事后审计。"
  printf '⚠ PPASS_HOOK_BYPASS：跳过核心禁区检查（原因：%s）\n' "$(trim "$PPASS_HOOK_BYPASS_REASON")" >&2
  exit 0
fi

# --no-renames：改名要同时算旧路径和新路径，否则 git mv 能把核心文件「搬」出核心目录。
FILES="$(git -c core.quotepath=false diff --cached --name-only --no-renames)" ||
  deny "读不到暂存区改动列表"
[ -n "$FILES" ] || exit 0

if BRANCH="$(git symbolic-ref --quiet --short HEAD)"; then :; else BRANCH=""; fi
case "$BRANCH" in
  batch/*) exit 0 ;;
esac
if [[ "$BRANCH" =~ ^(feat|fix|docs|test|ci)/([0-9]+)-. ]]; then
  ISSUE="${BASH_REMATCH[2]}"
else
  deny "当前分支「${BRANCH:-（detached HEAD）}」不是卡分支" \
    "卡分支格式：<type>/<issue号>-<slug>，type ∈ feat/fix/docs/test/ci；owner 的批分支是 batch/*。" \
    "开分支：git worktree add <目录> -b fix/<issue号>-<slug> origin/main"
fi

# 卡分支只许在独立 worktree 里提交：主仓工作区是产品负责人与其他会话共用的。
GIT_DIR_ABS="$(cd "$(git rev-parse --absolute-git-dir)" && pwd -P)"
COMMON_ABS="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
if [ "$GIT_DIR_ABS" = "$COMMON_ABS" ]; then
  deny "卡分支「${BRANCH}」在主仓工作区里，不在独立 worktree 里" \
    "一卡一 worktree：git fetch origin --prune && git worktree add <目录> -b <新卡分支> origin/main" \
    "已有改动先搬过去，然后把主仓切回原来的分支。"
fi

# 现取远端 main：取基线核心规则、判落后、认出合并提交。取不到（离线）只告警并回退 HEAD 核心规则。
MAIN_REF="refs/remotes/origin/main"
HAVE_MAIN=""
if GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o ConnectTimeout=5 -o BatchMode=yes}" \
  git fetch -q origin "+refs/heads/main:${MAIN_REF}" 2>/dev/null; then
  HAVE_MAIN=1
else
  printf '⚠ 取不到 origin/main（离线？），这次不检查卡分支是否落后 main\n' >&2
fi

MERGE_HEAD_SHA="$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null)" || MERGE_HEAD_SHA=""
if [ -n "$MERGE_HEAD_SHA" ] && [ -n "$HAVE_MAIN" ] &&
  git merge-base --is-ancestor "$MERGE_HEAD_SHA" "$MAIN_REF"; then
  OWN=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$(git rev-parse -q --verify ":${f}" 2>/dev/null)" = \
      "$(git rev-parse -q --verify "${MERGE_HEAD_SHA}:${f}" 2>/dev/null)" ] && continue
    OWN="${OWN}${f}
"
  done <<EOF
$FILES
EOF
  FILES="$(printf '%s' "$OWN" | sed '/^$/d')"
  printf 'ok: 合并 origin/main 的提交，只判与 main 不同的文件\n' >&2
  [ -n "$FILES" ] || exit 0
fi

REPO="${PPASS_HOOK_REPO:-}"
if [ -z "$REPO" ]; then
  REPO="$(git config --get remote.origin.url 2>/dev/null |
    sed -E -e 's#/+$##' -e 's#\.git$##' -e 's#^.*[:/]([^/:]+/[^/:]+)$#\1#')"
fi
[[ "$REPO" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] ||
  deny "解析不出 GitHub 仓库（origin URL 不认识）" "设 PPASS_HOOK_REPO=<owner>/<repo> 再提交。"

CARDS="$(git config --get "branch.${BRANCH}.ppasscards" 2>/dev/null)" || CARDS=""
case " ${CARDS} " in *" ${ISSUE} "*) ;; *) CARDS="${ISSUE}${CARDS:+ ${CARDS}}" ;; esac
CARDS_SHOW="#$(printf '%s' "$CARDS" | sed 's/  */、#/g')"

command -v gh >/dev/null 2>&1 ||
  deny "找不到 gh，查不了 ${CARDS_SHOW} 的标签，按拒绝处理" "装好并登录 gh（gh auth login）后再提交。"

CORE_CARD=""
for c in $CARDS; do
  [[ "$c" =~ ^[0-9]+$ ]] ||
    deny "分支 ${BRANCH} 记录的卡号「${c}」不对" "查看：git config --get branch.${BRANCH}.ppasscards（空格分隔的 issue 号）"
  if ! OUT="$(gh issue view "$c" -R "$REPO" --json labels,body \
    --jq '"labels:" + ([.labels[].name] | join(",")), .body' 2>&1)"; then
    deny "查询 ${REPO}#${c} 失败（离线、没登录或 issue 不存在），按拒绝处理" \
      "gh 输出：$(printf '%s' "$OUT" | head -3 | tr '\n' ' ')"
  fi
  OUT="$(printf '%s\n' "$OUT" | tr -d '\r')"
  case ",$(printf '%s\n' "$OUT" | sed -n '1s/^labels://p')," in *,core,*) CORE_CARD="${CORE_CARD:-$c}" ;; esac
done

# ── 核心禁区黑名单（优先取不可变基线 origin/main:.github/core-paths.txt，离线回退 HEAD）──
TMP_FILES=()
cleanup_tmp() {
  local t
  for t in ${TMP_FILES[@]+"${TMP_FILES[@]}"}; do rm -f "$t"; done
}
trap cleanup_tmp EXIT

ACTIVE_RULES="$RULES"
if [ -n "$HAVE_MAIN" ] && BASE_RULES="$(mktemp 2>/dev/null)"; then
  TMP_FILES+=("$BASE_RULES")
  if MSYS_NO_PATHCONV=1 git show "${MAIN_REF}:.github/core-paths.txt" >"$BASE_RULES" 2>/dev/null && [ -s "$BASE_RULES" ]; then
    ACTIVE_RULES="$BASE_RULES"
  fi
fi

# 即使卡带 core 标签，也不允许顺手篡改 .github/core-paths.txt 本身（除非专门修核心名单的卡或 batch/*）。
if printf '%s\n' "$FILES" | grep -qxF '.github/core-paths.txt' && [ -z "$CORE_CARD" ]; then
  deny "这是核心改动：.github/core-paths.txt 受基线核心禁区保护，无 core 标签禁止修改"
fi

CORE_ARGS=(core - "$ACTIVE_RULES")
if STAGED_DIFF="$(mktemp 2>/dev/null)"; then
  TMP_FILES+=("$STAGED_DIFF")
  if git -c core.quotepath=false diff --cached --no-renames --no-color --no-ext-diff --no-textconv \
    --src-prefix=a/ --dst-prefix=b/ >"$STAGED_DIFF" 2>/dev/null; then
    CORE_ARGS+=(--diff "$STAGED_DIFF")
  fi
fi
CORE_ERR="$(printf '%s\n' "$FILES" | bash "$PATHS" "${CORE_ARGS[@]}" 2>&1 >/dev/null)"
CORE="$(printf '%s\n' "$FILES" | bash "$PATHS" "${CORE_ARGS[@]}" 2>/dev/null)"
if [ "$CORE" != "false" ]; then
  if [ -n "$CORE_CARD" ]; then
    printf 'ok: #%s 带 core 标签，放行核心改动\n' "$CORE_CARD" >&2
  else
    HITS=()
    while IFS= read -r l; do
      case "$l" in 核心：*) HITS+=("$l") ;; esac
    done <<EOF
$CORE_ERR
EOF
    deny "这是核心改动：按 AGENTS.md 红线 6 只写复现/根因/两个修法，不改代码" \
      ${HITS[@]+"${HITS[@]}"} \
      "做法：git restore --staged <上面的文件> 并撤回改动；在 #${ISSUE} 里写复现、根因和两个修法，打 status:blocked。" \
      "owner 定下由谁实现后，会给 #${ISSUE} 打 core 标签，届时才放行。"
  fi
fi

# ── 落后 main ────────────────────────────────────────────────────────
# 两种情况拒绝：落后超过阈值；或 main 上已有本卡还没拿到的提交改过本次暂存的同一个文件（合并必冲突）。
if [ -n "$HAVE_MAIN" ]; then
  HAVE=(HEAD)
  [ -z "$MERGE_HEAD_SHA" ] || HAVE+=("$MERGE_HEAD_SHA")
  MAX="${PPASS_HOOK_MAX_BEHIND:-20}"
  BEHIND="$(git rev-list --count --first-parent "$MAIN_REF" --not "${HAVE[@]}" 2>/dev/null)" || BEHIND=0
  if [ "${BEHIND:-0}" -gt "$MAX" ]; then
    deny "卡分支落后 origin/main ${BEHIND} 个提交（上限 ${MAX}）" \
      "先跟上：git fetch origin && git rebase origin/main，重跑本地验证，再提交。"
  fi
  MAIN_TOUCHED="$(git -c core.quotepath=false log --format= --name-only "$MAIN_REF" --not "${HAVE[@]}" 2>/dev/null | sort -u)"
  STALE=()
  if [ -n "$MAIN_TOUCHED" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      printf '%s\n' "$MAIN_TOUCHED" | grep -qxF -- "$f" && STALE+=("$f")
    done <<EOF
$FILES
EOF
  fi
  if [ "${#STALE[@]}" -gt 0 ]; then
    deny "origin/main 上已有新提交改过本次暂存的文件，卡分支还没跟上" \
      "${STALE[@]/#/main 上改过：}" \
      "先跟上：git fetch origin && git rebase origin/main，重跑本地验证，再提交。"
  fi
fi

exit 0
