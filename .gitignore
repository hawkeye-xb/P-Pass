# P-Pass .gitignore

# Rust
target/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# Build artifacts
*.dmg
*.msi
*.apk
*.aab
*.so
# …but Android jniLibs MUST ship in the repo: the global *.so silently
# swallowed libiroh_ffi.so — every clone (CI, other machines) built APKs
# with no native lib, crashing on-device (UnsatisfiedLinkError, twice).
!apps/android/app/src/main/jniLibs/**/*.so

# Wrangler
.wrangler/
node_modules/

# Dev data
dev.db
dev.db-journal
dev.db-wal

# iroh-probe 持久化私钥（秘密，不进仓库）
iroh-probe.key
apps/android/.gradle/
apps/android/local.properties
apps/android/**/build/
