<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">P-Pass</string>

    <!-- Welcome -->
    <string name="welcome_headline">Photos,\nfinding their way home.</string>
    <string name="welcome_sub">Phone photos back up to your own computer at home. No cloud, no account, no monthly fee.</string>
    <string name="welcome_scan">Scan to connect the home computer</string>
    <!-- T-080 layout v1: welcome three steps -->
    <string name="welcome_step1">1 · Open P-Pass on the home computer</string>
    <string name="welcome_step2">2 · Use the button below to scan the code on its screen</string>
    <string name="welcome_step3">3 · Then there is nothing left to do</string>

    <!-- Scan -->
    <string name="scan_title">Point at the computer screen.</string>
    <string name="scan_hint">Hold steady — it reads by itself.</string>
    <!-- H-10b: manual pairing entry (QR too dense / camera trouble) -->
    <string name="scan_manual">Type it instead</string>
    <string name="scan_manual_hint">Paste the pairing code from the computer</string>
    <string name="scan_manual_paste">Paste</string>
    <string name="scan_manual_submit">Pair</string>
    <string name="scan_manual_invalid">That doesn\'t look like a P-Pass pairing code</string>
    <string name="scan_manual_back">Back to camera</string>
    <string name="cancel">Cancel</string>

    <!-- Pairing -->
    <string name="pair_waiting_title">Asking the computer…</string>
    <string name="pair_waiting_body">On the computer, click Allow when it asks.</string>
    <string name="pair_refused_title">The computer said no.</string>
    <string name="pair_refused_body">Ask the family owner to generate a fresh code and try again.</string>
    <string name="pair_failed_title">Could not reach the computer.</string>
    <string name="pair_failed_body">Make sure the computer is on and both devices have internet, then scan again.</string>
    <string name="scan_again">Scan again</string>
    <string name="joined_title">This phone has joined.</string>
    <string name="joined_body">Connected to %1$s.\nNext, choose which albums to back up.</string>
    <string name="done">Done</string>
    <!-- MOB-02 §一: 配对成功后的引导按钮（进相册选择页） -->
    <string name="choose_albums">Choose albums</string>
    <string name="not_a_code">This is not a P-Pass pairing code.</string>
    <string name="code_missing_addr">The code has no address — generate a fresh one on the computer.</string>

    <!-- Home / backup -->
    <string name="state_scanning">Looking for photos… %1$d</string>
    <string name="state_hashing">Reading %1$d/%2$d</string>
    <string name="state_sending">Sending %1$d/%2$d home</string>
    <string name="state_safe">All photos are backed up</string>
    <!-- T-080 defect(a): with K > 0 the status line may only speak of the debt -->
    <string name="state_pending">%1$d photos still to back up</string>
    <string name="state_trouble">Needs another try</string>
    <string name="safe_detail">%1$d new photos arrived home.</string>
    <string name="safe_detail_dup">%1$d new photos arrived home, %2$d were already there.</string>
    <string name="backup_now">Back up now</string>
    <string name="backup_pause">Pause</string>
    <!-- T-083: hero idle state (not drawn in the mock; adjudicated on the card) -->
    <string name="idle_auto_hint">Runs by itself while charging on Wi-Fi</string>
    <string name="state_no_albums">No albums selected — nothing to back up</string>
    <!-- T-083: trouble card — human copy only; raw errors live behind this fold -->
    <string name="try_again">Try again</string>
    <string name="trouble_details_show">Show technical details</string>
    <string name="trouble_details_hide">Hide technical details</string>
    <!-- UX-02: 失败通知（成功保持沉默） -->
    <string name="notif_backup_failed_title">Backup didn\'t finish</string>
    <string name="notif_backup_failed_body">%1$d photos didn\'t make it home — open to see</string>
    <!-- SENT-01: 手机盯电脑哨兵——先说照片没丢，再引导看电脑。 -->
    <string name="notif_sentinel_title">Haven\'t connected in 3 days</string>
    <string name="notif_sentinel_body">Your photos are safe — check that P-Pass is still running on your computer.</string>
    <!-- DOG-02b: 契机式白名单提醒——该跑没跑成才提醒。 -->
    <string name="notif_whitelist_title">Last night\'s backup didn\'t run</string>
    <string name="notif_whitelist_body">The system may be limiting background work. Allow P-Pass to run unrestricted — open to fix.</string>
    <string name="no_cloud">Photos go straight to your own computer. Nothing is uploaded to a cloud.</string>
    <!-- DOG-01: 恒真三元组（T-080 layout v1: hero card M / N home） -->
    <string name="dog_triplet_line">%1$d photos · %2$d backed up · %3$d to go</string>
    <string name="hero_of_n">/ %1$d photos home</string>
    <string name="pending_count">%1$d to back up</string>
    <string name="triplet_unavailable">Cannot read the photo count on this phone — it retries next time the app opens.</string>
    <string name="dog_last_success">Last success %1$s</string>
    <!-- T-080 defect(b): never render an epoch-0 date when nothing ever succeeded -->
    <string name="last_success_never">No successful backup yet</string>
    <string name="last_just_now">just now</string>
    <string name="last_mins_ago">%1$d min ago</string>
    <string name="last_hours_ago">%1$d h ago</string>
    <!-- T-080 layout v1: backup rules card -->
    <string name="rules_title">Backup rules</string>
    <string name="rule_notify">Notifications</string>
    <string name="rule_notify_value">Only on failure</string>
    <!-- T1: 版本号显示 -->
    <string name="setting_version">Version</string>
    <!-- T6: 相册选择 -->
    <string name="bucket_title">Choose albums to back up</string>
    <string name="bucket_hint">Albums you leave out are never backed up (e.g. photos WeChat received).</string>
    <string name="bucket_empty">No photos or videos found on this phone.</string>
    <string name="bucket_loading">Reading albums…</string>
    <string name="bucket_count">%1$d items</string>
    <string name="bucket_done">Back up %1$d albums</string>
    <!-- MOB-02 §六: 新相册徽标 -->
    <string name="bucket_new">New</string>
    <string name="backup_scope">Albums to back up</string>
    <string name="backup_scope_all">All albums</string>
    <string name="backup_scope_n">%1$d albums</string>
    <!-- UX-03: 后台规则一行 + 极简设置（MOB-02 起语义为「需要充电/需要
         Wi-Fi」两档运行条件，默认都开，各有后果描述 + 合成句） -->
    <string name="auto_backup_rule">Auto-backup runs while charging and on WiFi — no need to open the app.</string>
    <string name="setting_charge_only">Require charging</string>
    <string name="setting_wifi_only">Require Wi-Fi</string>
    <!-- MOB-02 §三: 开关后果描述 + 当前条件合成句（四种组合各有明确句子） -->
    <string name="req_charge_off_consequence">Will try to back up whenever new photos arrive — system-level watch, no extra battery drain</string>
    <string name="wifi_off_confirm_title">Turn off the Wi-Fi requirement?</string>
    <string name="wifi_off_confirm_body">Backup will also run on mobile data — it may use your data allowance.</string>
    <string name="wifi_off_confirm_ok">Turn off anyway</string>
    <string name="policy_both">Now: backs up automatically when charging and on Wi-Fi</string>
    <string name="policy_charge_only">Now: backs up automatically when charging (mobile data allowed)</string>
    <string name="policy_wifi_only">Now: backs up automatically on Wi-Fi (no charging needed)</string>
    <string name="policy_none">Now: backs up automatically any time</string>
    <!-- MOB-02 §四事件①: 排队提示 -->
    <string name="wifi_deferred_hint">Will run once Wi-Fi is available</string>
    <!-- MOB-02 §二: 部分授权引导 -->
    <string name="partial_access_title">Only some photos are accessible</string>
    <string name="partial_access_body">Backup needs access to the full library. Grant full photo access to back up everything.</string>
    <string name="partial_access_action">Open settings</string>
    <!-- MOB-03: 相册选择页权限链——拒绝引导（不崩不白屏，说清为什么需要） -->
    <string name="media_permission_denied_title">Photo access needed</string>
    <string name="media_permission_denied_body">Backup needs to see your photos and videos so you can pick which albums to back up. Grant access in system settings.</string>
    <!-- MOB-02 §一: 设置页低调立即备份入口（测试/狗粮用） -->
    <string name="manual_backup_entry">Back up now</string>
    <!-- REL-02/DESK-02①: 更新通道零 UI——由构建推导（版本含 -test. → test）。 -->
    <!-- DEV-01b: 重装识别开关行已隐藏（用户拍板）——strings 随 UI 删除。 -->
    <!-- DOG-02: 电池白名单引导卡片 -->
    <string name="dog_battery_title">Background protection off</string>
    <string name="dog_battery_body">Tip: whitelist P-Pass in battery settings, so the system won\'t interrupt backups while the screen is off.</string>
    <string name="dog_battery_action">Open settings</string>
    <string name="reconnect">Scan a new code</string>
    <!-- 配对已失效（存储端移除/吊销本设备后备份被拒） -->
    <string name="pairing_lost_title">Pairing with this computer is no longer valid</string>
    <string name="pairing_lost_body">Your photos are all still on this phone — nothing is lost. The computer may have removed this phone; scan the code again and backup resumes.</string>
    <!-- UX-06: 暂停自动备份 + 断开连接 -->
    <string name="auto_backup_pause">Auto backup</string>
    <string name="auto_backup_pause_hint">Charge + WiFi: new photos go home on their own</string>
    <string name="disconnect">Disconnect from this computer</string>
    <string name="disconnect_confirm_title">Disconnect?</string>
    <string name="disconnect_confirm_body">Backup progress on this phone will be reset and the family album will switch to a new storage computer. Photos on this phone stay put; photos on the old computer stay there too.</string>
    <string name="disconnect_confirm_ok">Disconnect</string>
    <string name="disconnect_failed_title">Could not disconnect</string>
    <string name="disconnect_failed">Could not reach the storage computer. Check that it is on, then try again.</string>
    <string name="ok">OK</string>
    <string name="run_failed">This backup didn\'t finish — it will try again automatically, and also with the next new photos or scheduled run.</string>

    <!-- Photos -->
    <string name="photos_title">Family photos</string>
    <string name="photos_count">%1$d photos</string>
    <string name="photos_count_dedup">%1$d photos · deduplicated</string>
    <!-- T-080 layout v1: photos light filter (all / this phone / family) -->
    <string name="chip_all">All</string>
    <string name="chip_local">This phone</string>
    <string name="chip_family">Family</string>
    <string name="photos_filter_empty">No photos under this filter yet.</string>
    <string name="photos_loading">Loading the family library…</string>
    <string name="photos_unreachable">Could not reach the computer.</string>
    <string name="photos_empty">No photos in the library yet — back up a batch first.</string>
    <!-- SYNC-04: live subscription gave up retrying — same UX-11 philosophy
         (bounded wait -> surface an error -> hand it to the user). -->
    <string name="photos_live_disconnected">Lost the live connection to the computer.</string>
    <string name="photos_live_retry">Retry</string>
    <string name="photos_live_reconnecting">Reconnecting to the computer…</string>
    <string name="back">Back</string>
    <string name="video_loading">Fetching the video from home… %1$d%%</string>
    <string name="video_failed">Could not fetch the video. Try again.</string>
    <!-- RET-01: 单张取回 = 使用动作（保存到相册 / 用其他应用打开） -->
    <string name="save_to_gallery">Save to Photos</string>
    <string name="open_with_app">Open with…</string>
    <string name="saved_to_gallery">Saved to Photos</string>
    <string name="no_app_for_file">No app on this phone can open this file.</string>
    <string name="share_download_failed">Could not fetch the original from home. Try again.</string>
    <!-- MOB-06: 右上角分享（ACTION_SEND 系统分享面板） -->
    <string name="share">Share</string>
    <string name="share_to">Share to…</string>

    <!-- Tabs -->
    <string name="tab_photos">Photos</string>
    <!-- UX-09: renamed from tab_backup — tab holds switches/rules/version/
         disconnect, not backup progress itself (real-device feedback). -->
    <string name="tab_settings">Settings</string>
</resources>
