---
/**
 * FAQ page body: index → grouped questions → answer paragraphs → optional links.
 * Content lives in src/i18n/faq.ts; this component only renders it, so both
 * language pages stay one-liners.
 *
 * Shape (#671): `a[0]` is the one-line answer and renders as .verdict (full
 * strength); the rest renders as .detail (secondary), so a visitor can read
 * just the first lines and still get an answer.
 *
 * The index is a plain anchor list. No accordion and no search box on purpose:
 * everything stays in the DOM, so Ctrl+F and in-page search still find an
 * answer that is not on screen, and nobody has to guess which headings open.
 */
import { FAQ, FAQ_LEDE, FAQ_TITLE, FAQ_TOC_LABEL } from '../i18n/faq';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const groups = FAQ[lang];
---

<article class="faq">
  <header>
    <h1>{FAQ_TITLE[lang]}</h1>
    <p class="lede">{FAQ_LEDE[lang]}</p>
  </header>

  <nav class="toc" aria-label={FAQ_TOC_LABEL[lang]}>
    {
      groups.map((group) => (
        <div class="toc-group">
          <a class="toc-group-title" href={`#${group.id}`}>
            {group.title}
          </a>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.q}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  {
    groups.map((group) => (
      <section id={group.id}>
        <h2>{group.title}</h2>
        {group.items.map((item) => {
          const more = item.more ?? [];
          const [verdict, ...detail] = item.a;
          return (
            <div class="qa" id={item.id}>
              <h3>{item.q}</h3>
              <p class="verdict">{verdict}</p>
              {detail.map((paragraph) => (
                <p class="detail">{paragraph}</p>
              ))}
              {more.length > 0 && (
                <p class="more">
                  {more.map((link, index) => (
                    <>
                      <a href={link.href} rel="external">
                        {link.label}
                      </a>
                      {index < more.length - 1 && <span aria-hidden="true"> · </span>}
                    </>
                  ))}
                </p>
              )}
            </div>
          );
        })}
      </section>
    ))
  }
</article>

<style>
  .faq {
    max-width: 40em;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 4rem;
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    margin: 0 0 0.5rem;
  }
  .lede {
    margin: 0 0 1rem;
    color: var(--text-secondary);
  }
  /* Index: the whole map of the page on one screen, so nobody has to scroll
     through 13 answers to find the one they came for. */
  .toc {
    margin: 1.75rem 0 0;
    padding: 1.1rem 1.25rem 0.6rem;
    background: var(--canvas);
    border-radius: var(--radius-card);
  }
  .toc-group + .toc-group {
    margin-top: 0.9rem;
  }
  .toc-group-title {
    display: inline-block;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.35rem 0;
    text-decoration: none;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li a {
    /* Same tap height as the site nav links: 44px, the desktop token. */
    display: block;
    box-sizing: border-box;
    min-height: var(--size-desktop-tap-min);
    padding: 0.55rem 0;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .toc li a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  /* Sticky header is ~45px tall; leave room so an anchored question does not
     land underneath it. */
  section[id],
  .qa[id] {
    scroll-margin-top: 4.5rem;
  }
  h2 {
    font-size: 1.35rem;
    margin: 3rem 0 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--hairline);
  }
  .qa {
    margin: 0 0 2rem;
  }
  .qa h3 {
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
  }
  .qa p {
    margin: 0 0 0.9rem;
    line-height: 1.75;
  }
  /* One-line answer, then the detail. Full-strength text for the answer,
     secondary for everything else. */
  .qa .verdict {
    color: var(--text);
  }
  .qa .detail {
    color: var(--text-secondary);
  }
  .qa p:last-child {
    margin-bottom: 0;
  }
  .more {
    font-size: 0.95rem;
    color: var(--text-meta);
  }
</style>
