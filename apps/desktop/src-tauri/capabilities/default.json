{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, native dialogs, and the app commands it calls (#1120: each app command is granted by name; nothing else is reachable)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/hawkeye-xb/P-Pass/releases/*"
        }
      ]
    },
    "updater:allow-check",
    "allow-daemon-status",
    "allow-daemon-low-space-ack",
    "allow-daemon-pairing-start",
    "allow-daemon-pairing-stop",
    "allow-daemon-pairing-pending",
    "allow-daemon-pairing-confirm",
    "allow-daemon-devices-list",
    "allow-daemon-device-watermarks",
    "allow-daemon-device-revoke",
    "allow-daemon-device-rename",
    "allow-daemon-device-folder",
    "allow-daemon-audit-list",
    "allow-daemon-timeline-page",
    "allow-daemon-thumb-get",
    "allow-daemon-asset-original",
    "allow-daemon-asset-path",
    "allow-service-state",
    "allow-wizard-state",
    "allow-platform-ux",
    "allow-update-failure-key",
    "allow-power-hint",
    "allow-open-power-settings",
    "allow-disable-auto-sleep",
    "allow-write-config",
    "allow-set-library-dir",
    "allow-start-daemon",
    "allow-daemon-startup-error",
    "allow-stop-daemon",
    "allow-pause-daemon-for-update",
    "allow-pending-shell-version",
    "allow-relaunch-shell",
    "allow-self-heal-daemon",
    "allow-resume-after-failed-update",
    "allow-update-failure-state",
    "allow-clear-update-failure",
    "allow-restart-daemon-process",
    "allow-kernel-convergence-phase",
    "allow-export-logs-bundle",
    "allow-library-reveal-path",
    "allow-is-test-build",
    "allow-pair-qr-svg",
    "allow-allow-media-scope",
    "allow-notify-system",
    "allow-set-tray-locale",
    "allow-update-download",
    "allow-update-install"
  ]
}
