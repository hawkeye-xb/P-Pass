/* Two iOS-only wait reasons (PPassCore WaitReason). */
"state_waiting_execution_blocked" = "iOS paused the backup when you left P-Pass. Come back to P-Pass and it carries on.";
"state_waiting_original_unavailable" = "Some originals are in iCloud; they will be downloaded and backed up once you are online.";

"ok_got_it" = "OK";
"bucket_summary" = "%1$@ photos will be backed up · automatically while P-Pass is open";

/* #1092：原图正从 iCloud 下载（还没开始传给电脑）。参数：下载百分比、第几张、共几张。 */
"state_fetching_icloud" = "Getting original from iCloud %1$ld%% · %2$ld of %3$ld";

"state_waiting_local_storage_full" = "This phone is out of storage. Free up some space and the backup carries on.";

/* #975：iOS 系统授权框只弹一次，被拒后只能去系统设置（Android 会再弹一次申请框）。 */
"rule_notify_denied_hint" = "Notifications are off in system Settings. Tap the switch to open Settings.";

"pair_save_failed" = "Could not save the pairing on this phone. Check the free storage, then scan again.";

/* #971 / #972: alert title for the transient notices. Android shows a Snackbar with no title; the notice texts themselves are shared (#1020, generated from Android strings.xml). */
"notice_title" = "Couldn’t finish";

/* #982: completion page after the first album pick. iOS has no battery-whitelist equivalent; background runs only when the system picks a moment (#343: no frequency, no guarantee). */
"background_backup_ios_note" = "If enabled, iOS may pick a moment to carry on backing up after you leave P-Pass. Whether and when is up to the system — it isn’t guaranteed.";

/* #1013：本地网络权限是 iOS 独有的系统弹窗（Android 无对应），弹出前在扫码页先说明用途。 */
"scan_local_network_note" = "After scanning, iPhone asks for Local Network access: it is used to find your computer on the same Wi‑Fi and transfer photos. Tap Allow.";

/* 设置页后台刷新告示（对位 Android background_backup_system_stopped 的句式：事实 · 后果，配「去处理」）。iOS 的系统开关叫「后台 App 刷新」。 */
"background_refresh_off_notice" = "Background App Refresh is off · backs up only when P-Pass is open";
"background_refresh_restricted_notice" = "Background refresh is restricted · backs up only when P-Pass is open";
