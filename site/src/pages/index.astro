---
import Base from '../layouts/Base.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const RELEASES = 'https://github.com/hawkeye-xb/P-Pass/releases/latest';

const pillars = [
  {
    title: '照片回家',
    body: '手机自动备份到家里自己的电脑——不经过任何人的云。原图在你家，索引随时能从原图重建。',
  },
  {
    title: '为 60 岁的家人设计',
    body: '拿到手机，扫一次码，之后什么都不用做。打开 App 就能得到「照片安全吗」的真话。',
  },
  {
    title: '开源 · 端到端加密',
    body: '中继只转发密文、不落盘不解密。数据不上云，不进我们任何库。按类型逐步扩展。',
  },
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <picture class="beast">
      <source media="(prefers-color-scheme: dark)" srcset="/icons/icon-beast-night.svg" />
      <img src="/icons/icon-beast.svg" alt="P-Pass 屋脊兽图标" width="160" height="160" />
    </picture>
    <p class="overline">P2P 家庭照片备份</p>
    <h1>给家人的照片，备份回自己家</h1>
    <p class="lede">
      家人的照片自动备份到你家电脑。没有云，没有账号，没有订阅——
      设备之间直接传输，中继只做转发兜底。
    </p>
    <a class="cta" href={RELEASES} rel="external">
      下载 P-Pass
      <span class="cta-sub">macOS / Android · GitHub Releases</span>
    </a>
  </section>

  <section class="pillars">
    <article>
      <h2>{pillars[0].title}</h2>
      <p>{pillars[0].body}</p>
    </article>
    <article>
      <h2>{pillars[1].title}</h2>
      <p>{pillars[1].body}</p>
    </article>
    <article>
      <h2>{pillars[2].title}</h2>
      <p>{pillars[2].body}</p>
    </article>
  </section>

  <section class="privacy-note">
    <h2>隐私不是功能，是立场</h2>
    <p>
      这个站没有任何统计脚本，没有 tracker，没有 cookie 弹窗。
      我们做隐私备份，官网自己也该这样。
    </p>
  </section>
</Base>

<style>
  .hero {
    max-width: 960px;
    margin: 0 auto;
    padding: 4.5rem 1.25rem 3.5rem;
    text-align: center;
  }
  .beast img {
    width: 128px;
    height: 128px;
    margin-bottom: 1.5rem;
  }
  .overline {
    font-size: var(--size-desktop-overline);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-meta);
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1.25rem;
  }
  .lede {
    max-width: 34em;
    margin: 0 auto 2rem;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }
  .cta {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    background: var(--ink);
    color: var(--paper);
    padding: 0.9rem 2.2rem;
    border-radius: var(--radius-control);
    text-decoration: none;
    font-weight: 600;
    transition: background 0.15s ease;
  }
  .cta:hover { background: var(--ink-hover); color: var(--paper); }
  .cta-sub {
    font-size: 0.8rem;
    font-weight: 400;
    opacity: 0.75;
  }
  @media (prefers-color-scheme: dark) {
    .cta { background: var(--paper); color: var(--ink); }
    .cta:hover { background: var(--linen); color: var(--ink); }
  }

  .pillars {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .pillars article {
    background: var(--canvas);
    border-radius: var(--radius-card);
    padding: 1.75rem 1.5rem;
  }
  .pillars h2 {
    font-size: 1.35rem;
    margin: 0 0 0.75rem;
  }
  .pillars p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.98rem;
  }
  @media (max-width: 760px) {
    .pillars { grid-template-columns: 1fr; }
  }

  .privacy-note {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
    text-align: center;
  }
  .privacy-note h2 { font-size: 1.4rem; margin: 0 0 0.75rem; }
  .privacy-note p {
    max-width: 32em;
    margin: 0 auto;
    color: var(--text-meta);
  }
</style>
