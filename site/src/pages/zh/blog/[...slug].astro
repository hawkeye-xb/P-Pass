---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { t } from '../../../i18n/ui';
import { breadcrumb } from '../../../schema';

export async function getStaticPaths() {
  const visible = (data: { draft?: boolean; lang: string }) =>
    (import.meta.env.PROD ? data.draft !== true : true);
  const posts = await getCollection('blog', ({ data }) => visible(data) && data.lang === 'zh');
  const enIds = new Set(
    (await getCollection('blog', ({ data }) => visible(data) && data.lang === 'en')).map((p) =>
      p.id.replace(/-en$/, ''),
    ),
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, mirror: enIds.has(post.id) ? `/blog/${post.id}/` : undefined },
  }));
}

const { post, mirror } = Astro.props;
const { title, date, tags } = post.data;
const { Content } = await render(post);

const jsonLd = breadcrumb([
  { name: 'P-Pass', path: '/zh/' },
  { name: t('zh', 'nav.blog'), path: '/zh/blog/' },
  { name: title, path: Astro.url.pathname },
]);
---

<Base lang="zh" title={`${title} — P-Pass`} mirror={mirror} jsonLd={jsonLd}>
  <article class="post">
    <header>
      <p class="meta">
        <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
        {tags.length > 0 && <span class="tags"> · {tags.join(' / ')}</span>}
      </p>
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-foot">
      <a href="/zh/blog/">{t('zh', 'post.back')}</a>
    </footer>
  </article>
</Base>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 4rem;
  }
  .meta {
    color: var(--text-meta);
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
  }
  h1 { font-size: 2.1rem; margin: 0 0 1.75rem; }
  .post-foot { margin-top: 3rem; }
</style>
