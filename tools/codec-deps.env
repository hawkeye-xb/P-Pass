# 桌面端 C 编解码库的版本——唯一来源。
#
# 读这个文件的地方：
#   - tools/build-codecs-macos.sh        macOS 按这里的版本从源码编译（下载后校验 SHA-256）
#   - .github/actions/vcpkg-libheif      Windows 的 vcpkg 钉在 VCPKG_PIN_SHA
#   - tools/check-codec-libs.sh          打包后检查实际版本不低于 *_MIN，且不含禁用的库
#
# 升级步骤：改版本号与 SHA-256（macOS），把 VCPKG_PIN_SHA 换成 ports/libheif、
# ports/libde265 已是新版本的 vcpkg 提交（Windows），再把 *_MIN 提到新版本。
# 只改其中一处，打包检查会挡住。
# 格式：纯 KEY=VALUE，不许有 shell 展开——bash `source` 和 GitHub Actions 都直接读它。

LIBHEIF_VERSION=1.23.7
LIBHEIF_SHA256=f7483e818503ea6224c8863e4a56ac02c7089021a98472c811c12aa19faf2475
LIBDE265_VERSION=1.1.3
LIBDE265_SHA256=554228bd17788c99a7e63b37ab5634722190e6e2bf60c1dcb01cef328e133905

# 包内版本下限：低于它构建失败。
LIBHEIF_MIN=1.23.7
LIBDE265_MIN=1.1.3

# microsoft/vcpkg 提交：ports/libheif 1.23.7、ports/libde265 1.1.3。
VCPKG_PIN_SHA=d7b4974a4199586fda8201d74f80cacaaa27368d

