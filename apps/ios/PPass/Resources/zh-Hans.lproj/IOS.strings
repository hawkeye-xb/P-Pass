/* iOS 新增的两个等待原因（PPassCore WaitReason：executionBlocked 对位 Android FGS_BLOCKED；originalUnavailable 是 iCloud 原图，#311 D4）。 */
"state_waiting_execution_blocked" = "离开 P-Pass 后系统暂停了备份。回到 P-Pass 就会接着传。";
"state_waiting_original_unavailable" = "有的照片原图在 iCloud 里，联网后会先下载再备份。";

/* 失败提示框的确认按钮（#971）。完成页现在用 Android 的「开启后台备份 / 不开启后台备份」（#982）。 */
"ok_got_it" = "好的";
/* Android 原句说「默认连 Wi-Fi 且电量不低时自动进行」，iOS 本轮是打开 App 时备份。 */
"bucket_summary" = "将备份 %1$@ 张 · 打开 P-Pass 时自动备份";

/* #1092：原图正从 iCloud 下载（还没开始传给电脑）。参数：下载百分比、第几张、共几张。 */
"state_fetching_icloud" = "正在从 iCloud 获取原图 %1$ld%% · 第 %2$ld / %3$ld 张";

/* PPassCore WaitReason.localStorageFull：手机自己空间不够放临时原图。 */
"state_waiting_local_storage_full" = "手机存储空间不够，腾出一些空间后接着备份。";

/* #975：iOS 系统授权框只弹一次，被拒后只能去系统设置（Android 会再弹一次申请框）。 */
"rule_notify_denied_hint" = "通知已在系统设置里关闭。点开关前往系统设置打开。";

/* #971 / #972：一过性提示的弹框标题。Android 用无标题的 Snackbar；提示正文两端共用（#1020，由 Android strings.xml 生成）。 */
"notice_title" = "没能完成";

/* #982：首次选完相册的完成页。Android 在这里申请电池白名单；iOS 没有对应物，后台只能由系统挑时机（#343：不写频率、不假装能保证）。 */
"background_backup_ios_note" = "开启后，离开 P-Pass 时 iOS 可能会找机会接着备份；是否执行、何时执行由系统决定，不保证。";

/* #1013：本地网络权限是 iOS 独有的系统弹窗（Android 无对应），弹出前在扫码页先说明用途。 */
"scan_local_network_note" = "扫码后，iPhone 会请求「本地网络」权限：用于在同一 Wi‑Fi 下找到你的电脑，传输照片。请点「允许」。";

/* 设置页后台刷新告示（对位 Android background_backup_system_stopped 的句式：事实 · 后果，配「去处理」）。iOS 的系统开关叫「后台 App 刷新」。 */
"background_refresh_off_notice" = "后台 App 刷新已关闭 · 只在打开 P-Pass 时备份";
"background_refresh_restricted_notice" = "后台刷新被系统限制 · 只在打开 P-Pass 时备份";

/* 读屏（VoiceOver）：网格缩略图的标签。Android 用的是哈希前缀，读出来没有意义，iOS 单独给一句人话。 */
"a11y_thumb_video" = "视频";
"a11y_thumb_photo" = "照片";

