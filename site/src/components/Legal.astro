---
/**
 * Shared shell for the legal pages (privacy policy / terms of use):
 * title + last-updated line + prose body. Content lives in the page files.
 */
interface Props {
  title: string;
  updated: string;
  updatedLabel: string;
}

const { title, updated, updatedLabel } = Astro.props;
---

<article class="legal">
  <header>
    <h1>{title}</h1>
    <p class="meta">{updatedLabel}：<time datetime={updated}>{updated}</time></p>
  </header>
  <div class="prose">
    <slot />
  </div>
</article>

<style>
  .legal {
    max-width: 40em;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 4rem;
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    margin: 0 0 0.5rem;
  }
  .meta {
    margin: 0 0 2.5rem;
    color: var(--text-meta);
    font-size: 0.9rem;
  }
  .prose :global(h2) {
    font-size: 1.2rem;
    margin: 2.25rem 0 0.75rem;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--text-secondary);
    line-height: 1.75;
  }
  .prose :global(ul) {
    padding-left: 1.25rem;
  }
</style>
