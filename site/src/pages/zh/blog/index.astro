---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t } from '../../../i18n/ui';

const posts = (
  await getCollection('blog', ({ data }) => {
    // Drafts are visible in dev (review) but excluded from production builds.
    return (import.meta.env.PROD ? data.draft !== true : true) && data.lang === 'zh';
  })
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base lang="zh" title={`${t('zh', 'blog.h1')} — P-Pass`} description={t('zh', 'blog.description')} mirror="/blog/">
  <section class="blog">
    <h1>{t('zh', 'blog.h1')}</h1>
    <p class="sub">{t('zh', 'blog.sub')}</p>

    {
      posts.length === 0 ? (
        <p class="empty">{t('zh', 'blog.empty')}</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/zh/blog/${post.id}/`}>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toISOString().slice(0, 10)}
                </time>
                <span class="post-title">{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>

<style>
  .blog {
    max-width: 720px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 4rem;
  }
  h1 { font-size: 2.2rem; margin: 0 0 0.5rem; }
  .sub { color: var(--text-secondary); margin: 0 0 2.5rem; }
  .empty { color: var(--text-meta); }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .post-list li {
    border-bottom: 1px solid var(--hairline);
  }
  .post-list a {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1rem 0;
    text-decoration: none;
  }
  .post-list time {
    color: var(--text-meta);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .post-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
  }
  .post-list a:hover .post-title { text-decoration: underline; }
  @media (max-width: 640px) {
    .post-list a { flex-direction: column; gap: 0.2rem; }
  }
</style>
