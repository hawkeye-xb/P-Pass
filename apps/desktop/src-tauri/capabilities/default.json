{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs + native dialogs (folder picker, confirm)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "opener:allow-reveal-item-in-dir",
    "updater:default"
  ]
}
