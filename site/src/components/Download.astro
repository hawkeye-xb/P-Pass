---
/**
 * Download block, shared by the landing hero and the zh entry page.
 *
 * One component = one set of download URLs. `consts.ts` stays the single place
 * where those URLs are defined, so the landing page and any other page that
 * offers a download can never drift apart.
 *
 * Both languages download from the stable `P-Pass-latest.*` names on the
 * Cloudflare mirror (GitHub asset names carry the version, so they cannot be
 * linked per platform); GitHub Releases stays as the secondary link for anyone
 * who wants to verify checksums or browse older builds.
 *
 * Layout follows the usual "detected platform first" pattern: the server
 * renders all three buttons at equal weight (that is also the no-JS view); a
 * small script reads the visitor's OS and promotes the matching button to the
 * big primary one, the others drop to a quiet secondary row. Phones and
 * unknown systems keep the equal row. iPhone ships through a TestFlight
 * public link: iPhone / iPad visitors get it as their main button, everyone
 * else sees it as a quiet line under the desktop and Android buttons.
 */
import { MIRROR_ANDROID, MIRROR_MAC, MIRROR_WINDOWS, RELEASES_URL, TESTFLIGHT_URL } from '../consts';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const iphoneStepsHref = lang === 'zh' ? '/zh/faq/#iphone-testflight' : '/faq/#iphone-testflight';
const platforms = [
  { os: 'mac', href: MIRROR_MAC, label: 'hero.cta.mac', sub: 'hero.cta.mac.sub', short: 'Mac' },
  { os: 'win', href: MIRROR_WINDOWS, label: 'hero.cta.win', sub: 'hero.cta.win.sub', short: 'Windows' },
  { os: 'android', href: MIRROR_ANDROID, label: 'hero.cta.android', sub: 'hero.cta.android.sub', short: 'Android' },
] as const;
---

<div class="dl" data-detected="">
  <div class="cta-row">
    <span class="cta-others">{t(lang, 'hero.cta.others')}</span>
    {
      platforms.map((p) => (
        <a class="cta" data-os={p.os} href={p.href} rel="external">
          <span class="cta-main">
            {t(lang, p.label)}
            <span class="cta-badge">{t(lang, 'hero.cta.badge')}</span>
          </span>
          <span class="cta-sub">{t(lang, p.sub)}</span>
          <span class="cta-short">{p.short}</span>
        </a>
      ))
    }
  </div>
  <div class="cta-ios">
    <a class="cta is-primary" href={TESTFLIGHT_URL} rel="external">
      <span class="cta-main">
        {t(lang, 'hero.cta.ios')}
        <span class="cta-badge">{t(lang, 'hero.cta.badge')}</span>
      </span>
      <span class="cta-sub">{t(lang, 'hero.cta.ios.sub')}</span>
    </a>
  </div>
  <p class="cta-iphone">
    <a href={TESTFLIGHT_URL} rel="external">{t(lang, 'hero.cta.iphone')}</a>
    {' · '}
    <a href={iphoneStepsHref}>{t(lang, 'hero.cta.iphone.steps')}</a>
  </p>
  <p class="cta-note">{t(lang, 'hero.cta.win.note')}</p>
  <p class="cta-alt">
    <a href={RELEASES_URL} rel="external">{t(lang, 'hero.cta.alt')}</a>
  </p>
</div>

<script>
  // Desktop browsers report their OS reliably; iPadOS pretends to be a Mac,
  // so a Mac UA with touch points is treated as iOS (nothing to download yet).
  function detect(): string {
    const ua = navigator.userAgent;
    if (/Android/i.test(ua)) return 'android';
    if (/iPhone|iPad|iPod/i.test(ua) || (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1)) return 'ios';
    if (/Windows/i.test(ua)) return 'win';
    if (/Macintosh|Mac OS X/i.test(ua)) return 'mac';
    return '';
  }
  const os = detect();
  for (const el of document.querySelectorAll<HTMLElement>('.dl')) {
    el.dataset.detected = os;
    const primary = el.querySelector<HTMLElement>(`.cta[data-os="${os}"]`);
    if (primary) {
      primary.classList.add('is-primary');
      // Primary first, the rest keep their order in the secondary row.
      primary.parentElement?.prepend(primary);
    }
  }
</script>

<style>
  .cta {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-height: 56px;
    box-sizing: border-box;
    background: var(--ink);
    color: var(--paper);
    padding: 0.9rem 2.2rem;
    border-radius: var(--radius-control);
    text-decoration: none;
    font-weight: 600;
    transition: background 0.15s ease;
  }
  .cta:hover { background: var(--ink-hover); color: var(--paper); }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
  }

  /* A platform was detected: its button stays the big filled one on its own
     line, the others become quiet outlined links below it. */
  .dl:is([data-detected='mac'], [data-detected='win'], [data-detected='android'], [data-detected='ios']) .cta-row .cta:not(.is-primary) {
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    font-weight: 500;
    font-size: 0.9rem;
  }
  .dl:is([data-detected='mac'], [data-detected='win'], [data-detected='android'], [data-detected='ios']) .cta-row .cta:not(.is-primary):hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .dl:is([data-detected='mac'], [data-detected='win'], [data-detected='android'], [data-detected='ios']) .cta-row .cta:not(.is-primary) .cta-badge,
  .dl:is([data-detected='mac'], [data-detected='win'], [data-detected='android'], [data-detected='ios']) .cta-row .cta:not(.is-primary) .cta-sub {
    display: none;
  }
  .dl:is([data-detected='mac'], [data-detected='win'], [data-detected='android'], [data-detected='ios']) .cta-row {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: center;
  }
  .cta.is-primary {
    grid-column: 1 / -1;
    justify-self: center;
    margin-bottom: 0.25rem;
    padding: 1.1rem 2.6rem;
    font-size: 1.1rem;
  }

  /* The Windows note only matters when Windows is offered as the main choice
     or nothing was detected; the iOS note only for iPhone / iPad visitors. */
  .cta-ios { display: none; }
  /* iPhone / iPad: the TestFlight button is the main one, so it goes above
     the (now secondary) desktop and Android row. */
  .dl[data-detected='ios'] { display: flex; flex-direction: column; }
  .dl[data-detected='ios'] .cta-ios { display: block; order: -1; margin-bottom: 0.75rem; }
  /* Nothing in that row installs on the phone in hand, so it shrinks to one
     quiet line: "Also for: Mac · Windows · Android". */
  .cta-others,
  .cta-short { display: none; }
  .dl[data-detected='ios'] .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0 0.9rem;
    font-size: 0.9rem;
    color: var(--text-meta);
  }
  .dl[data-detected='ios'] .cta-others { display: inline; }
  .dl[data-detected='ios'] .cta-row .cta:not(.is-primary) {
    min-height: 44px;
    padding: 0;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--text-meta);
  }
  .dl[data-detected='ios'] .cta-row .cta .cta-main { display: none; }
  .dl[data-detected='ios'] .cta-row .cta .cta-short { display: inline; }
  .dl[data-detected='ios'] .cta-iphone { display: none; }
  .dl:is([data-detected='mac'], [data-detected='android'], [data-detected='ios']) .cta-note { display: none; }

  .cta-alt {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
  }
  .cta-alt a { color: var(--text-meta); }
  .cta-note,
  .cta-iphone {
    margin: 0.6rem auto 0;
    max-width: 36rem;
    font-size: 0.85rem;
    color: var(--text-meta);
  }
  .cta-iphone a { color: var(--text-meta); }
  .cta-main {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* Beta badge: amber = waiting (token meaning color). Green is reserved
     for "photos safely stored" and never appears on this page. */
  .cta-badge {
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--waiting-bg);
    color: var(--waiting);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  .cta-sub {
    font-size: 0.8rem;
    font-weight: 400;
    opacity: 0.75;
  }
  @media (prefers-color-scheme: dark) {
    .cta { background: var(--paper); color: var(--ink); }
    .cta:hover { background: var(--linen); color: var(--ink); }
  }
</style>
