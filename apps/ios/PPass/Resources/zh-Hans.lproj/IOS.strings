/* iOS 独有或 Android 说法在 iOS 上不成立的文案（#315）。手写；同名 key 盖过 Localizable.strings（由 Android strings.xml 生成）。
   每条都要说清为什么 iOS 不同：见行尾注释。 */

/* 选范围页：没有照片权限（拒绝了）时不说「没有找到照片」，说没有权限并给「去设置」（iOS 独有：Android 拒绝后回首页，不进这一页）。 */
"bucket_no_access_title" = "无照片访问权限";
"bucket_no_access_body" = "无法读取这台手机上的照片，没法备份。";
"bucket_no_access_action" = "去设置";

/* 失败通知（#981）：iOS 点通知只打开 App、不会直达系统设置，指路写 iOS 设置项名字；电池优化在 iOS 上不存在，对位的是「后台 App 刷新」。 */
"notif_media_partial_body" = "照片权限已改为部分照片，只有选中的照片会备份。在「设置 › P-Pass › 照片」可改回「完整访问」。";
"notif_media_none_body" = "照片权限已关闭，备份已停止。在「设置 › P-Pass › 照片」允许访问。";
"notif_background_refresh_off_title" = "「后台 App 刷新」已关闭";
"notif_background_refresh_off_body" = "现在只有打开 P-Pass 时才会备份。可在「设置 › 通用 › 后台 App 刷新」重新打开。";
"notif_background_refresh_restricted_body" = "这台 iPhone 限制了 P-Pass 的后台刷新（可能是屏幕使用时间或设备管理），现在只有打开 P-Pass 时才会备份。";

/* 模拟器与没有相机的设备。 */
