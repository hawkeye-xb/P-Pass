---
import { RELEASES_URL } from '../consts';
import { t, type Lang } from '../i18n/ui';
import PromoVideo from './PromoVideo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const pillars = [
  { title: t(lang, 'pillar1.title'), body: t(lang, 'pillar1.body') },
  { title: t(lang, 'pillar2.title'), body: t(lang, 'pillar2.body') },
  { title: t(lang, 'pillar3.title'), body: t(lang, 'pillar3.body') },
];
---

<section class="hero">
  {t(lang, 'hero.overline') && <p class="overline">{t(lang, 'hero.overline')}</p>}
  <h1>{t(lang, 'hero.h1')}</h1>
  <p class="lede">{t(lang, 'hero.lede')}</p>
  {t(lang, 'hero.tagline') && <p class="tagline">{t(lang, 'hero.tagline')}</p>}
  <a class="cta" href={RELEASES_URL} rel="external">
    <span class="cta-main">
      {t(lang, 'hero.cta')}
      <span class="cta-badge">{t(lang, 'hero.cta.badge')}</span>
    </span>
    <span class="cta-sub">{t(lang, 'hero.cta.sub')}</span>
  </a>
</section>

<PromoVideo lang={lang} />

<section class="pillars">
  {
    pillars.map((p) => (
      <article>
        <h2>{p.title}</h2>
        <p>{p.body}</p>
      </article>
    ))
  }
</section>


<style>
  .hero {
    max-width: 960px;
    margin: 0 auto;
    padding: 3rem 1.25rem 2.5rem;
    text-align: center;
  }
  .overline {
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-meta);
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    margin: 0 0 1.25rem;
    text-wrap: balance;
  }
  .lede {
    max-width: 34em;
    margin: 0 auto 2rem;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }
  /* Second line for technical visitors (en only; zh leaves it empty). */
  .tagline {
    margin: -0.75rem auto 1.75rem;
    color: var(--text-meta);
    font-size: 0.95rem;
  }
  .cta {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-height: 56px;
    box-sizing: border-box;
    background: var(--ink);
    color: var(--paper);
    padding: 0.9rem 2.2rem;
    border-radius: var(--radius-control);
    text-decoration: none;
    font-weight: 600;
    transition: background 0.15s ease;
  }
  .cta:hover { background: var(--ink-hover); color: var(--paper); }
  .cta-main {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* Beta badge: amber = waiting (token meaning color). Green is reserved
     for "photos safely stored" and never appears on this page. */
  .cta-badge {
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--waiting-bg);
    color: var(--waiting);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  .cta-sub {
    font-size: 0.8rem;
    font-weight: 400;
    opacity: 0.75;
  }
  @media (prefers-color-scheme: dark) {
    .cta { background: var(--paper); color: var(--ink); }
    .cta:hover { background: var(--linen); color: var(--ink); }
  }


  .pillars {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .pillars article {
    background: var(--canvas);
    border-radius: var(--radius-card);
    padding: 1.75rem 1.5rem;
  }
  .pillars h2 {
    font-size: 1.35rem;
    margin: 0 0 0.75rem;
  }
  .pillars p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.98rem;
  }
  @media (max-width: 760px) {
    .pillars { grid-template-columns: 1fr; }
  }
</style>
