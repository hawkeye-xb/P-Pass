{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    },
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.js", "src/**/*.svelte"]
}
