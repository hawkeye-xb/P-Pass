---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  const visible = (data: { draft?: boolean; lang: string }) =>
    (import.meta.env.PROD ? data.draft !== true : true);
  const posts = await getCollection('blog', ({ data }) => visible(data) && data.lang === 'en');
  const zhIds = new Set(
    (await getCollection('blog', ({ data }) => visible(data) && data.lang === 'zh')).map(
      (p) => p.id,
    ),
  );
  return posts.map((post) => {
    const base = post.id.replace(/-en$/, '');
    return {
      params: { slug: base },
      props: { post, mirror: zhIds.has(base) ? `/zh/blog/${base}/` : undefined },
    };
  });
}

const { post, mirror } = Astro.props;
const { title, date, tags } = post.data;
const { Content } = await render(post);
---

<Base lang="en" title={`${title} — P-Pass`} mirror={mirror}>
  <article class="post">
    <header>
      <p class="meta">
        <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
        {tags.length > 0 && <span class="tags"> · {tags.join(' / ')}</span>}
      </p>
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-foot">
      <a href="/blog/">{t('en', 'post.back')}</a>
    </footer>
  </article>
</Base>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 4rem;
  }
  .meta {
    color: var(--text-meta);
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
  }
  h1 { font-size: 2.1rem; margin: 0 0 1.75rem; }
  .post-foot { margin-top: 3rem; }
</style>
