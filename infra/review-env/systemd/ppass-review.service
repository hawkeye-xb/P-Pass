[Unit]
Description=P-Pass review daemon (Linux headless, 审核验证环境)
Documentation=https://github.com/hawkeye-xb/P-Pass/blob/main/infra/review-env/README.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/ppass-review/bin/daemon
Restart=on-failure
RestartSec=5
# 数据目录进 /var/lib，二进制进 /opt —— 归档和 reset 都只碰这两个位置。
# #1115：常驻 daemon 不认 PPF_DATA_DIR（库位置只来自平台目录 / config）。Linux 的平台目录是
# $XDG_DATA_HOME/p-pass，没有 config 时库就是它 ⇒ 实际库与令牌在 /var/lib/ppass-review/p-pass/。
Environment=XDG_DATA_HOME=/var/lib/ppass-review
Environment=PPF_BIND_ADDR=0.0.0.0:41146
# 审核环境不回报遥测：这不是正式服务。
Environment=PPF_TELEMETRY_ENABLED=false
Environment=PPF_LOG_LEVEL=info
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
