<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>P-Pass</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- 只用标准算法（TLS 1.3 / QUIC、AES-GCM、Ed25519；BLAKE3 只做哈希、不属加密），无自研或非标准加密。
	     这些加密由 App 自带的 Rust 库（rustls / ring）实现，不是 Apple 系统提供的：按 App Store Connect 的
	     「Export compliance documentation for encryption」，这一档只有在法国分发时才要上传法国加密声明，
	     所以销售范围排除法国（#937），其他地区不需要文件，声明 NO。以后要进法国，先办声明再改这里。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.hawkeyexb.ppass.backup</string>
		<string>com.hawkeyexb.ppass.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>fetch</string>
	</array>
	<!-- #941：冷启动画面 = paper 底色 + 居中图标（对齐 Android 的 paper 底 + 启动图标）。
	     LaunchBackground 是 tokens.json 的 paper，由 tools/ios/gen-tokens.py 生成；不要手写色值。 -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Manrope-Regular.ttf</string>
		<string>Manrope-Medium.ttf</string>
		<string>Manrope-Bold.ttf</string>
		<string>Newsreader-Regular.ttf</string>
		<string>Newsreader-Medium.ttf</string>
		<string>Newsreader-SemiBold.ttf</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan the pairing QR code shown on your home computer.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Used to find your computer on the same Wi‑Fi and transfer photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Automatic backup needs access to all photos.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save a photo from your home library back to this phone.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
