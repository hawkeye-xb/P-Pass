/* iOS-only copy, or Android wording that is not true on iOS (#315). Hand-written; a key here
   overrides the same key in Localizable.strings (generated from Android strings.xml). */

/* Failure notifications (#981): tapping a notification on iOS only opens the app (no deep link into system settings), so point at the iOS setting by name; battery optimization doesn't exist on iOS — the counterpart is Background App Refresh. */
"notif_media_partial_body" = "Photo access is now limited, so auto backup can't continue. You can change it to “Full Access” anytime in Settings › Privacy & Security › Photos › P-Pass.";
"notif_media_none_body" = "Photo access is off, so auto backup has stopped. You can change it to “Full Access” anytime in Settings › Privacy & Security › Photos › P-Pass.";
"notif_background_refresh_off_title" = "Background App Refresh is off";
"notif_background_refresh_off_body" = "Backup now runs only while P-Pass is open. You can turn it back on in Settings › General › Background App Refresh.";
"notif_background_refresh_restricted_body" = "This iPhone restricts Background App Refresh for P-Pass (possibly Screen Time or device management). Backup now runs only while P-Pass is open.";

/* Scope page when no photo can be read (access denied): say there is no access and offer Open Settings, not "No photos found" (iOS only: Android goes home after a denial and never shows this page). */
"bucket_no_access_title" = "No photo access";
"bucket_no_access_body" = "P-Pass can't read photos on this phone, so it can't back them up.";
"bucket_no_access_action" = "Open Settings";

/* Simulator and devices without a camera. */
"scan_camera_unavailable" = "Camera unavailable. Enter the pairing code to connect.";

