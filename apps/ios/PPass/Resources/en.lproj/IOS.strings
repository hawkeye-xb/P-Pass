/* Two iOS-only wait reasons (PPassCore WaitReason). */
"state_waiting_execution_blocked" = "iOS paused the backup when you left P-Pass. It resumes when you return.";
"state_waiting_original_unavailable" = "Some originals are in iCloud. They are downloaded and backed up when online.";

"ok_got_it" = "OK";

/* #1092：原图正从 iCloud 下载（还没开始传给电脑）。参数：下载百分比、第几张、共几张。 */
"state_fetching_icloud" = "Getting original from iCloud %1$ld%% · %2$ld of %3$ld";

"state_waiting_local_storage_full" = "This phone is out of storage. Free up space to resume backup.";

/* #975：iOS 系统授权框只弹一次，被拒后只能去系统设置（Android 会再弹一次申请框）。 */
"rule_notify_denied_hint" = "Notifications are off in system Settings. Tap the switch to open Settings.";

/* #971 / #972: alert title for the transient notices. Android shows a Snackbar with no title; the notice texts themselves are shared (#1020, generated from Android strings.xml). */
"notice_title" = "Couldn’t finish";

/* #1013：本地网络权限是 iOS 独有的系统弹窗（Android 无对应），弹出前在扫码页先说明用途。 */
"scan_local_network_note" = "After scanning, iPhone asks for Local Network access. If you allow it, photos go straight to your computer on the same Wi‑Fi, which is faster.";

/* 设置页后台刷新告示（对位 Android background_backup_system_stopped 的句式：事实 · 后果，配「去设置」，打开系统设置）。iOS 的系统开关叫「后台 App 刷新」。 */
"background_refresh_off_notice" = "Background App Refresh is off · backs up only when P-Pass is open";
"background_refresh_restricted_notice" = "Background refresh is restricted · backs up only when P-Pass is open";
"background_refresh_notice_action" = "Open Settings";

/* 读屏（VoiceOver）：网格缩略图的标签。Android 用的是哈希前缀，读出来没有意义，iOS 单独给一句人话。 */
"a11y_thumb_video" = "Video";
"a11y_thumb_photo" = "Photo";

/* #1272 挑几张传：照片不复制进 App，只在前台传（PHPicker 的 itemProvider 只在进程存活期间有效）——所以说离开 P-Pass 会暂停。Android 没有这个限制，不说这句。 */
/* #1272：进程在传输中被杀，句柄（itemProvider）随进程没了、无法续传，只能提示重新挑。Android 靠持久 URI 授权可续传，没有这句。%1$ld = 上次挑的张数，%2$ld = 没传完的张数。 */
"picked_interrupted" = "Of the %1$ld photos you picked last time, %2$ld weren't sent. Please pick them again.";

/* #1272 B：设置页末尾「更多」二级页入口（存储电脑、断开连接、版本、检查更新）。 */
"more_label" = "More";

/* #1323（iOS 独有）：部分照片权限之后怎么改成全部。iOS 不会再弹授权框，只能在系统设置里改；Android 由系统权限框自己说明。
   路径按苹果官方「隐私与安全性 › 照片」（iOS 14 至今都在，不受 iOS 18 把 App 设置挪到「App」分组影响），选项名 iOS 18 起为「完全访问」。 */
"photo_access_change_later_hint" = "You can change it to “Full Access” anytime in Settings › Privacy & Security › Photos › P-Pass.";

/* 照片页引导卡：iOS 没有「App 关闭也能备份」，靠后台 App 刷新（产品负责人 11-04）。 */
"photos_guide_background" = "Back up in the background";
